{ describe, expect, it } from vitest
{
  analyzeVertex
  emptyDirections
  relationConstraint
  symmetricConstraint
  type GraphDefinition
} from ../src/model.civet
{ EXAMPLES } from ../src/examples.civet

star: GraphDefinition :=
  id: "star"
  group: "Full graphs"
  title: "Star"
  description: ""
  vertices: [{ id: "v", x: 0, y: 0, constraint: symmetricConstraint(3, [1]) }]
  edges: [0, 1, 2].map((port) => ({
    id: `e${port}`
    ends: [{ vertex: "v", port }, { x: 100 + port, y: 0 }]
  }))

describe "partial vertex analysis", =>
  it "starts viable and unforced", =>
    analysis := analyzeVertex(star, emptyDirections(star), star.vertices[0])
    expect(analysis.state).toBe "open"
    expect(analysis.compatible).toHaveLength(3);

  it "finds forced edges after one incoming edge", =>
    analysis := analyzeVertex(star, { e0: 0, e1: null, e2: null }, star.vertices[0])
    expect(analysis.state).toBe "forced"
    expect(analysis.forced.get("e1")).toBe 1
    expect(analysis.forced.get("e2")).toBe(1);

  it "reports a local contradiction", =>
    analysis := analyzeVertex(star, { e0: 0, e1: 0, e2: null }, star.vertices[0])
    expect(analysis.state).toBe "impossible"
    expect(analysis.compatible).toHaveLength(0);

  it("supports ordered asymmetric relations", =>
    constraint := relationConstraint(2, ["10"], "ordered", "O")
    expect(constraint.allowed).toEqual([1]);
  );

function satisfyingAssignments(graph: GraphDefinition)
  solutions: Record<string, 0 | 1>[] := []
  directions := emptyDirections(graph)

  function search(edgeIndex: number)
    if edgeIndex is graph.edges#
      solutions.push({ ...directions } as Record<string, 0 | 1>)
      return

    edge := graph.edges[edgeIndex]
    for direction of [0, 1] as const
      directions[edge.id] = direction
      viable := graph.vertices.every(
        (vertex) => analyzeVertex(graph, directions, vertex).state is not "impossible"
      )
      search(edgeIndex + 1) if viable
    directions[edge.id] = null;

  search 0
  return solutions

function boundaryMask(graph: GraphDefinition, directions: Record<string, 0 | 1>)
  boundary := graph.edges.filter((edge) => edge.ends.some((end) => not ("vertex" in end)))
  return boundary.reduce((mask, edge, index) =>
    internalIndex := edge.ends.findIndex((end) => "vertex" in end) as 0 | 1
    return mask | (Number(directions[edge.id] is internalIndex) << index)
  , 0);

describe "example suite", =>
  it.each(EXAMPLES.filter(({ id }) => id is not "all-equalizer-k4").map((example) => [example.title, example] as const))(
    "%s has a satisfying orientation"
    (_, graph) => expect(satisfyingAssignments(graph)#).toBeGreaterThan(0)
  )

  it "the two-vertex gadget has exactly the 1-in-4 boundary relation", =>
    graph := EXAMPLES.find(({ id }) => id is "one-in-four")!
    masks := new Set(satisfyingAssignments(graph).map((solution) => boundaryMask(graph, solution)))
    expect([...masks].sort((a, b) => a - b)).toEqual([1, 2, 4, 8]);

  it "the parsimonious gadget uniquely realizes every 2-in-4 boundary state", =>
    graph := EXAMPLES.find(({ id }) => id is "parsimonious-two-in-four")!
    counts := new Map<number, number>()
    for solution of satisfyingAssignments(graph)
      mask := boundaryMask(graph, solution)
      counts.set(mask, (counts.get(mask) ?? 0) + 1)
    expect([...counts.entries()].sort(([a], [b]) => a - b)).toEqual([
      [3, 1], [5, 1], [6, 1], [9, 1], [10, 1], [12, 1]
    ]);

  it "the planar crossover uniquely propagates both crossing signals", =>
    graph := EXAMPLES.find(({ id }) => id is "crossover")!
    counts := new Map<number, number>()
    for solution of satisfyingAssignments(graph)
      mask := boundaryMask(graph, solution)
      counts.set(mask, (counts.get(mask) ?? 0) + 1)
    expect([...counts.entries()].sort(([a], [b]) => a - b)).toEqual([
      [3, 1], [5, 1], [10, 1], [12, 1]
    ]);

  it "Figure 4 has the two orientations induced by its satisfying assignments", =>
    graph := EXAMPLES.find(({ id }) => id is "figure-4-one-in-three-go")!
    expect(graph.vertices).toHaveLength 16
    expect(graph.edges).toHaveLength 24
    expect(satisfyingAssignments(graph)).toHaveLength 2

    gridPoints := [
      ...graph.vertices
      ...graph.edges.flatMap(({ route }) => route ?? [])
    ]
    for { x, y } of gridPoints
      expect(Number.isInteger((x - 70) / 80)).toBe true
      expect(Number.isInteger((1020 - y) / 80)).toBe(true);

  it "the equalizer K₄ has two satisfying orientations", =>
    graph := EXAMPLES.find(({ id }) => id is "equalizer-k4-puzzle")!
    solutions := satisfyingAssignments(graph)
    expect(solutions).toHaveLength 2

    for solution of solutions
      expect(["el", "er", "em"].every((edgeId) => solution[edgeId] is 1)).toBe(true);

  it "the all-equalizer K₄ is impossible", =>
    graph := EXAMPLES.find(({ id }) => id is "all-equalizer-k4")!
    expect(satisfyingAssignments(graph)).toHaveLength(0);

  it "the two-equalizer K₄ has two satisfying orientations", =>
    graph := EXAMPLES.find(({ id }) => id is "two-equalizer-k4")!
    expect(satisfyingAssignments(graph)).toHaveLength 2
    expect(graph.vertices.filter(({ constraint }) => constraint.shortLabel is "=").map(({ id }) => id)).toEqual([
      "left"
      "right"
    ]);

  it "the triangular prism has four pairs of directed cycles", =>
    graph := EXAMPLES.find(({ id }) => id is "triangular-prism")!
    solutions := satisfyingAssignments(graph)
    expect(solutions).toHaveLength 4

    for solution of solutions
      expect(["match-top", "match-left", "match-right"].every(
        (edgeId) => solution[edgeId] is 1
      )).toBe true

    vertices := Object.fromEntries(graph.vertices.map((vertex) => [vertex.id, vertex]))
    for prefix of ["outer", "inner"]
      top := vertices[`${prefix}-top`]
      left := vertices[`${prefix}-left`]
      right := vertices[`${prefix}-right`]
      base := Math.hypot(right.x - left.x, right.y - left.y)
      side := Math.hypot(top.x - left.x, top.y - left.y)
      expect(Math.abs(base - side) / base).toBeLessThan(0.002);

  it("the all-equalizer cube has its two bipartite orientations", =>
    graph := EXAMPLES.find(({ id }) => id is "all-equalizer-cube")!
    expect(satisfyingAssignments(graph)).toHaveLength 2

    vertices := Object.fromEntries(graph.vertices.map((vertex) => [vertex.id, vertex]))
    expect(vertices["outer-ne"].x - vertices["outer-nw"].x).toBe(
      vertices["outer-sw"].y - vertices["outer-nw"].y
    )
    expect(vertices["inner-ne"].x - vertices["inner-nw"].x).toBe(
      vertices["inner-sw"].y - vertices["inner-nw"].y
    );
  );
