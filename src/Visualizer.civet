{ For, Show, batch, createEffect, createMemo, createSignal, onCleanup } from solid-js;
{ EXAMPLES } from ./examples.civet;
graphStyles from "./graph.sass?inline";
{
  type Constraint,
  type Edge,
  type EdgeDirection,
  type EdgeEnd,
  type GraphDefinition,
  type Vertex,
  analyzeVertex,
  emptyDirections,
  incidencesAt
} from ./model.civet;

NODE_RADIUS := 29;
NODE_EDGE_PADDING := NODE_RADIUS + 4;

export interface Point { x: number; y: number }
type Theme = "light" | "dark";
type DirectionState = Record<string, EdgeDirection>;
type DirectionUpdate = DirectionState | ((current: DirectionState) => DirectionState);
interface LabelPart { text: string; italic: boolean }
interface DragCandidate {
  edge: Edge;
  fraction: number;
  distance: number;
  source: "edge" | "endpoint";
}

EDGE_SWIPE_MINIMUM_PIXELS := 12;
EDGE_SWIPE_MINIMUM_FRACTION := 0.004;
EDGE_HIT_RADIUS := 20;
ENDPOINT_DRAG_MINIMUM_PIXELS := 12;
ENDPOINT_DRAG_RADIUS := NODE_RADIUS + 18;

THEME_STORAGE_KEY := "graph-orientation-theme";
SVG_NAMESPACE := "http://www.w3.org/2000/svg";
XMLNS_NAMESPACE := "http://www.w3.org/2000/xmlns/";
SVG_XML_PREAMBLE := '<?xml version="1.0" encoding="UTF-8"?>';
GRAPH_STYLE_PROPERTIES := [
  "--font-family",
  "--graph-neutral",
  "--primary",
  "--cyan",
  "--selection-glow",
  "--red",
  "--paper",
  "--ink",
  "--node-surface",
  "--canvas-background",
  "--forced-surface",
  "--satisfied-surface",
  "--impossible-surface",
  "--green",
  "--on-accent"
] as const;

export parseLabelMarkup := (label: string): LabelPart[] => {
  const parts: LabelPart[] = [];
  italic := /<i>(.*?)<\/i>/g;
  cursor .= 0;
  for (const match of label.matchAll(italic)) {
    if (match.index > cursor) parts.push({ text: label[cursor..<match.index], italic: false });
    parts.push({ text: match[1], italic: true });
    cursor = match.index + match[0]#;
  }
  if (cursor < label#) parts.push({ text: label[>=cursor], italic: false });
  return parts# ? parts : [{ text: label, italic: false }];
};

plainLabel := (label: string) => {
  return parseLabelMarkup(label).map(({ text }) => text).join("");
};

export platformUsesCommandKey := (platform: string) => {
  return /mac|iphone|ipad|ipod/i.test(platform);
};

export contradictionSummary := (violated: number, incomplete: number) => {
  const messages: string[] = [];
  if (violated > 0) {
    messages.push(`${violated} ${violated is 1 ? "vertex is" : "vertices are"} violated.`);
  }
  if (incomplete > 0) {
    messages.push(`${incomplete} ${incomplete is 1 ? "vertex has" : "vertices have"} no possible completion.`);
  }
  return messages.join(" ");
};

detectedPlatform := => {
  userAgentData := (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData;
  return userAgentData?.platform or navigator.platform or navigator.userAgent;
};

export serializeGraphSvg := (source: SVGSVGElement, theme: Theme): string => {
  svg := source.cloneNode(true) as SVGSVGElement;
  if (not svg.hasAttribute("xmlns")) svg.setAttributeNS(XMLNS_NAMESPACE, "xmlns", SVG_NAMESPACE);
  svg.setAttribute("data-theme", theme);

  viewBox := svg.getAttribute("viewBox")?.trim().split(/[ ,]+/).map(Number);
  if (viewBox?# is 4 and viewBox.every(Number.isFinite)) {
    if (not svg.hasAttribute("width")) svg.setAttribute("width", String(viewBox[2]));
    if (not svg.hasAttribute("height")) svg.setAttribute("height", String(viewBox[3]));
  }

  computedStyle := getComputedStyle(source);
  for (const property of GRAPH_STYLE_PROPERTIES) {
    value := computedStyle.getPropertyValue(property);
    if (value) svg.style.setProperty(property, value);
  }

  style := document.createElementNS(SVG_NAMESPACE, "style");
  style.setAttribute("data-svg-export", "");
  style.textContent = graphStyles;
  svg.prepend(style);

  return `${SVG_XML_PREAMBLE}\n${new XMLSerializer().serializeToString(svg)}\n`;
};

initialTheme := : Theme => {
  try {
    saved := window.localStorage.getItem(THEME_STORAGE_KEY);
    if (saved is "light" or saved is "dark") return saved;
  } catch {
    // Storage can be unavailable in privacy-restricted contexts.
  }
  return window.matchMedia?.("(prefers-color-scheme: dark)").matches ? "dark" : "light";
};

endpointPoint := (graph: GraphDefinition, end: EdgeEnd): Point => {
  if ("vertex" in end) {
    vertex := graph.vertices.find(({ id }) => id is end.vertex);
    throw new Error(`Missing vertex ${end.vertex}`) unless vertex
    return { vertex.{x,y} };
  }
  return end;
};

unit := (point: Point): Point => {
  length := Math.hypot(point.x, point.y) or 1;
  return { x: point.x / length, y: point.y / length };
};

edgeGeometry := (graph: GraphDefinition, edge: Edge) => {
  rawStart := endpointPoint(graph, edge.ends[0]);
  rawEnd := endpointPoint(graph, edge.ends[1]);
  firstWaypoint := edge.route?.[0];
  lastWaypoint := edge.route?.[edge.route# - 1];
  startDirection := edge.control
    ? unit({ x: edge.control.x - rawStart.x, y: edge.control.y - rawStart.y })
    : unit({
        x: (firstWaypoint ?? rawEnd).x - rawStart.x,
        y: (firstWaypoint ?? rawEnd).y - rawStart.y
      });
  endDirection := edge.control
    ? unit({ x: rawEnd.x - edge.control.x, y: rawEnd.y - edge.control.y })
    : unit({
        x: rawEnd.x - (lastWaypoint ?? rawStart).x,
        y: rawEnd.y - (lastWaypoint ?? rawStart).y
      });
  startPadding := "vertex" in edge.ends[0] ? NODE_EDGE_PADDING : 0;
  endPadding := "vertex" in edge.ends[1] ? NODE_EDGE_PADDING : 0;
  start := {
    x: rawStart.x + startDirection.x * startPadding,
    y: rawStart.y + startDirection.y * startPadding
  };
  end := {
    x: rawEnd.x - endDirection.x * endPadding,
    y: rawEnd.y - endDirection.y * endPadding
  };
  if (edge.control) {
    middle := ` Q ${edge.control.x} ${edge.control.y}`;
    forward := `M ${start.x} ${start.y}${middle} ${end.x} ${end.y}`;
    reverse := `M ${end.x} ${end.y}${middle} ${start.x} ${start.y}`;
    midpoint := {
      x: 0.25 * start.x + 0.5 * edge.control.x + 0.25 * end.x,
      y: 0.25 * start.y + 0.5 * edge.control.y + 0.25 * end.y
    };
    return { start, end, midpoint, forward, reverse };
  }

  points := [start, ...(edge.route ?? []), end];
  path := (pathPoints: Point[]) => {
    return `M ${pathPoints.map(({ x, y }) => `${x} ${y}`).join(" L ")}`;
  };
  lengths := points.slice(1).map((point, index) => {
    return Math.hypot(point.x - points[index].x, point.y - points[index].y);
  });
  halfway := lengths.reduce((sum, length) => sum + length, 0) / 2;
  traversed .= 0;
  midpoint .= { ...start };
  for (let index = 0; index < lengths#; index += 1) {
    length := lengths[index];
    if traversed + length >= halfway
      fraction := length is 0 ? 0 : (halfway - traversed) / length;
      midpoint = {
        x: points[index].x + fraction * (points[index + 1].x - points[index].x),
        y: points[index].y + fraction * (points[index + 1].y - points[index].y)
      };
      break;
    traversed += length;
  }
  forward := path(points);
  reverse := path([...points].reverse());
  return { start, end, midpoint, forward, reverse };
};

eventPoint := (
  event: MouseEvent | PointerEvent,
  element: SVGGraphicsElement | SVGSVGElement
): Point => {
  svg := element instanceof SVGSVGElement ? element : element.ownerSVGElement;
  matrix := svg?.getScreenCTM();
  if (not svg or not matrix) return { x: 0, y: 0 };
  point := svg.createSVGPoint();
  point.x = event.clientX;
  point.y = event.clientY;
  local := point.matrixTransform(matrix.inverse());
  return { local.{x,y} };
};

closestPathLocation := (path: SVGPathElement, point: Point) => {
  length := path.getTotalLength();
  bestFraction .= 0;
  bestDistance .= Number.POSITIVE_INFINITY;
  for (let step = 0; step <= 60; step += 1) {
    fraction := step / 60;
    sample := path.getPointAtLength(length * fraction);
    distance := (sample.x - point.x) ** 2 + (sample.y - point.y) ** 2;
    if distance < bestDistance
      bestDistance = distance;
      bestFraction = fraction;
  }
  radius .= 1 / 60;
  for (let pass = 0; pass < 2; pass += 1) {
    start := Math.max(0, bestFraction - radius);
    end := Math.min(1, bestFraction + radius);
    for let step = 0; step <= 12; step += 1
      fraction := start + (end - start) * step / 12;
      sample := path.getPointAtLength(length * fraction);
      distance := (sample.x - point.x) ** 2 + (sample.y - point.y) ** 2;
      if distance < bestDistance
        bestDistance = distance;
        bestFraction = fraction;
    radius /= 12;
  }
  return { fraction: bestFraction, distance: Math.sqrt(bestDistance) };
};

closestFraction := (path: SVGPathElement, point: Point): number => {
  return closestPathLocation(path, point).fraction;
};

edgeZone := (fraction: number): 0 | 1 | 2 => {
  return fraction < 1 / 3 ? 0 : fraction > 2 / 3 ? 1 : 2;
};

export edgeSwipeDirection := (
  startFraction: number,
  endFraction: number,
  startPoint: Point,
  endPoint: Point
): 0 | 1 | null => {
  distance := Math.hypot(endPoint.x - startPoint.x, endPoint.y - startPoint.y);
  progress := endFraction - startFraction;
  if (distance < EDGE_SWIPE_MINIMUM_PIXELS or Math.abs(progress) < EDGE_SWIPE_MINIMUM_FRACTION) return null;
  return progress > 0 ? 1 : 0;
};

directionLabel := (edge: Edge, direction: 0 | 1): string => {
  end := edge.ends[direction];
  return "vertex" in end ? `toward ${end.vertex}` : "toward the dangling end";
};

constraintRule := (constraint: Constraint): string => {
  exact := /^(\d+)-in-(\d+)$/.exec(constraint.name);
  if (exact) return `Exactly ${exact[1]} of ${exact[2]} edges point inward`;
  if (constraint.name is `{0,${constraint.degree}}-in-${constraint.degree}`) {
    return "All edges point inward or all point outward";
  }
  if (constraint.name is "synchronizer") {
    return "The + ports agree, the − ports agree, and the two pairs are opposite";
  }
  if (constraint.name is "6-alternator") {
    return "Neighboring ports alternate inward and outward";
  }
  return constraint.name;
};

export function Visualizer()
  let graphCanvas: SVGSVGElement?;
  let activeDrag: {
    pointerId: number;
    startCandidates: DragCandidate[];
    startPoint: Point;
    startEdgeId?: string;
    startVertexId?: string;
  } | null = null;
  let suppressedEdgeClick: { edgeId: string; expires: number } | null = null;
  let suppressedVertexClick: { vertexId: string; expires: number } | null = null;
  usesCommandKey := platformUsesCommandKey(detectedPlatform());
  historyModifier := usesCommandKey ? "Command" : "Ctrl";
  [theme, setTheme] := createSignal<Theme>(initialTheme());
  [selectedId, setSelectedId] := createSignal(EXAMPLES[0].id);
  selectedGraph := createMemo(=> EXAMPLES.find(({ id }) => id is selectedId()) ?? EXAMPLES[0]);
  [directions, setDirections] := createSignal<DirectionState>(emptyDirections(selectedGraph()));
  [undoStack, setUndoStack] := createSignal<DirectionState[]>([]);
  [redoStack, setRedoStack] := createSignal<DirectionState[]>([]);
  canUndo := createMemo(=> undoStack()# > 0);
  canRedo := createMemo(=> redoStack()# > 0);
  [hovered, setHovered] := createSignal<{ edge: string; zone: 0 | 1 | 2 } | null>(null);

  vertexTypes := createMemo(=> {
    grouped := new Map<string, { constraint: Constraint; labels: Set<string> }>();
    for (const vertex of selectedGraph().vertices) {
      key := `${vertex.constraint.name}:${vertex.constraint.allowed.join(",")}`;
      group := grouped.get(key) ?? { vertex.constraint, labels: new Set<string>() };
      if (vertex.label) group.labels.add(vertex.label);
      grouped.set(key, group);
    }
    return [...grouped.values()].map(({ constraint, labels }) => {
      visibleLabels := [...labels];
      symbol := visibleLabels# is 0
        ? constraint.shortLabel
        : `${visibleLabels.slice(0, 2).join(", ")}${visibleLabels.length > 2 ? ", …" : ""}`;
      return { symbol, rule: constraintRule(constraint) };
    });
  });

  analyses := createMemo(=> Object.fromEntries(
    selectedGraph().vertices.map((vertex) => [
      vertex.id,
      analyzeVertex selectedGraph(), directions(), vertex
    ])
  ));

  forcedEdges := createMemo(=> {
    const result: Record<string, { direction: 0 | 1 | null; conflict: boolean }> = {};
    for (const edge of selectedGraph().edges) {
      implied := new Set<0 | 1>();
      for analysis of Object.values(analyses())
        direction := analysis.forced.get(edge.id);
        implied.add(direction) unless direction is undefined
      result[edge.id] = {
        direction: implied.size is 1 ? [...implied][0] : null,
        conflict: implied.size > 1
      };
    }
    return result;
  });

  progress := createMemo(=> {
    values := Object.values(analyses());
    oriented := Object.values(directions()).filter((direction) => direction !== null)#;
    impossible := values.filter(({ state }) => state is "impossible")#;
    violated := values.filter(({ state, assignedPorts, totalPorts }) => {
      return state is "impossible" and assignedPorts is totalPorts;
    })#;
    incompleteImpossible := impossible - violated;
    satisfied := values.filter(({ state }) => state is "satisfied")#;
    forced := values.filter(({ state }) => state is "forced")#;
    edgeConflicts := Object.values(forcedEdges()).filter(({ conflict }) => conflict)#;
    solved := oriented is selectedGraph().edges# and satisfied is selectedGraph().vertices#;
    return { oriented, impossible, violated, incompleteImpossible, satisfied, forced, edgeConflicts, solved };
  });

  directionsEqual := (first: DirectionState, second: DirectionState) => {
    keys := Object.keys(first);
    return keys# is Object.keys(second)# and keys.every((key) => first[key] is second[key]);
  };

  commitDirections := (update: DirectionUpdate) => {
    current := directions();
    next := update <? "function" ? update(current) : update;
    if (directionsEqual(current, next)) return;
    batch(=> {
      setUndoStack((stack) => [...stack, current]);
      setRedoStack([]);
      setDirections(next);
    });
  };

  undo := => {
    stack := undoStack();
    previous := stack[stack# - 1];
    return unless previous
    current := directions();
    batch(=> {
      setUndoStack(stack[<-1]);
      setRedoStack((redo) => [...redo, current]);
      setDirections(previous);
    });
  };

  redo := => {
    stack := redoStack();
    next := stack[stack# - 1];
    return unless next
    current := directions();
    batch(=> {
      setRedoStack(stack[<-1]);
      setUndoStack((undoHistory) => [...undoHistory, current]);
      setDirections(next);
    });
  };

  chooseExample := (id: string) => {
    graph := EXAMPLES.find((example) => example.id is id) ?? EXAMPLES[0];
    batch(=> {
      setSelectedId(graph.id);
      setDirections(emptyDirections(graph));
      setUndoStack([]);
      setRedoStack([]);
      setHovered(null);
    });
  };

  setEdge := (edgeId: string, direction: EdgeDirection) => {
    commitDirections((current) => ({ ...current, [edgeId]: direction }));
  };

  interactWithEdge := (event: MouseEvent, edge: Edge) => {
    path := event.currentTarget as SVGPathElement;
    fraction := closestFraction(path, eventPoint(event, path));
    setEdge(edge.id, fraction < 1 / 3 ? 0 : fraction > 2 / 3 ? 1 : null);
  };

  clickEdge := (event: MouseEvent, edge: Edge) => {
    if (suppressedEdgeClick?.edgeId is edge.id and performance.now() <= suppressedEdgeClick.expires) {
      suppressedEdgeClick = null;
      return;
    }
    suppressedEdgeClick = null;
    interactWithEdge(event, edge);
  };

  cycleEdge := (edge: Edge) => {
    current := directions()[edge.id];
    setEdge(edge.id, current === null ? 1 : current is 1 ? 0 : null);
  };

  applyForcedAt := (vertex: Vertex) => {
    forced := analyses()[vertex.id].forced;
    if (forced.size is 0) return;
    commitDirections((current) => {
      next := { ...current };
      forced.forEach((direction, edgeId) => { next[edgeId] = direction; });
      return next;
    });
  };

  applyAllForced := => {
    currentAnalyses := analyses();
    commitDirections((current) => {
      next := { ...current };
      for (const vertex of selectedGraph().vertices) {
        analysis := currentAnalyses[vertex.id];
        if (analysis.state is not "forced") continue;
        analysis.forced.forEach((direction, edgeId) => { next[edgeId] = direction; });
      }
      return next;
    });
  };

  endpointCandidatesNear := (point: Point, allowedEdgeIds?: Set<string>) => {
    const candidates: DragCandidate[] = [];
    for (const edge of selectedGraph().edges) {
      if (allowedEdgeIds and not allowedEdgeIds.has(edge.id)) continue;
      edge.ends.forEach((end, index) => {
        endpoint := endpointPoint(selectedGraph(), end);
        distance := Math.hypot(endpoint.x - point.x, endpoint.y - point.y);
        if (distance <= ENDPOINT_DRAG_RADIUS) {
          candidates.push({ edge, fraction: index, distance, source: "endpoint" });
        }
      });
    }
    return candidates.sort((first, second) => first.distance - second.distance);
  };

  pathForEdge := (edgeId: string) => {
    return graphCanvas?.querySelector<SVGPathElement>(`.edge-hit[data-edge-id="${edgeId}"]`) ?? null;
  };

  dragCandidatesAt := (event: PointerEvent, allowedEdgeIds?: Set<string>) => {
    return [] unless graphCanvas
    point := eventPoint(event, graphCanvas);
    candidates := endpointCandidatesNear(point, allowedEdgeIds);
    targetPath := ((event.target as Element | null)?.closest?.(".edge-hit") ?? null) as SVGPathElement | null;
    targetEdgeId := targetPath?.dataset.edgeId;
    visited := new Set<string>();

    if (targetPath and targetEdgeId and (not allowedEdgeIds or allowedEdgeIds.has(targetEdgeId))) {
      edge := selectedGraph().edges.find(({ id }) => id is targetEdgeId);
      if edge
        location := closestPathLocation(targetPath, point);
        candidates.push({ edge, ...location, source: "edge" });
        visited.add(edge.id);
    }

    if (allowedEdgeIds) {
      for edgeId of allowedEdgeIds
        if (visited.has(edgeId)) continue;
        edge := selectedGraph().edges.find(({ id }) => id is edgeId);
        path := pathForEdge(edgeId);
        if (not edge or not path or path.getTotalLength !<? "function") continue;
        location := closestPathLocation(path, point);
        if location.distance <= EDGE_HIT_RADIUS
          candidates.push({ edge, ...location, source: "edge" });
    }
    return candidates;
  };

  resolveDrag := (event: PointerEvent) => {
    drag := activeDrag;
    return null unless drag
    allowed := new Set(drag.startCandidates.map(({ edge }) => edge.id));
    endCandidates := dragCandidatesAt(event, allowed);
    let best: { edge: Edge; direction: 0 | 1; score: number } | null = null;
    for (const start of drag.startCandidates) {
      for end of endCandidates
        continue unless start.edge.id is end.edge.id
        direction := edgeSwipeDirection(
          start.fraction,
          end.fraction,
          drag.startPoint,
          { x: event.clientX, y: event.clientY }
        );
        if (direction === null) continue;
        specificity := Number(start.source is "edge") + Number(end.source is "edge");
        unoriented := directions()[start.edge.id] === null ? 1 : 0;
        progress := Math.abs(end.fraction - start.fraction);
        score := specificity * 10000 + unoriented * 100 + progress * 10 - start.distance - end.distance;
        if (not best or score > best.score) best = { start.edge, direction, score };
    }
    return best;
  };

  resolveSameEdgeZone := (event: PointerEvent) => {
    drag := activeDrag;
    return null unless drag
    allowed := new Set(drag.startCandidates.map(({ edge }) => edge.id));
    endCandidates := dragCandidatesAt(event, allowed);
    let best: { edge: Edge; zone: 0 | 1 | 2; score: number } | null = null;
    for (const start of drag.startCandidates) {
      if (drag.startEdgeId and start.edge.id is not drag.startEdgeId) continue;
      for end of endCandidates
        continue unless start.edge.id is end.edge.id
        zone := edgeZone(start.fraction);
        if (zone is not edgeZone(end.fraction)) continue;
        specificity := Number(start.source is "edge") + Number(end.source is "edge");
        score := specificity * 10000 - start.distance - end.distance;
        if (not best or score > best.score) best = { start.edge, zone, score };
    }
    return best;
  };

  endsNearStartVertex := (event: PointerEvent) => {
    vertexId := activeDrag?.startVertexId;
    vertex := vertexId and selectedGraph().vertices.find(({ id }) => id is vertexId);
    if (not vertex or not graphCanvas) return false;
    point := eventPoint(event, graphCanvas);
    return Math.hypot(vertex.x - point.x, vertex.y - point.y) <= ENDPOINT_DRAG_RADIUS;
  };

  beginDrag := (event: PointerEvent) => {
    if (activeDrag or event.button is not 0 or event.isPrimary is false or not graphCanvas) return;
    candidates := dragCandidatesAt(event);
    startVertex := (event.target as Element | null)?.closest?.("[data-vertex-id]") as SVGGElement | null;
    startVertexId := startVertex?.dataset.vertexId;
    filtered := startVertexId
      ? candidates.filter(({ edge, fraction, source }) => {
          if (source is not "endpoint") return false;
          end := edge.ends[fraction as 0 | 1];
          return "vertex" in end and end.vertex is startVertexId;
        })
      : candidates;
    if (filtered# is 0) return;
    startPath := (event.target as Element | null)?.closest?.(".edge-hit") as SVGPathElement | null;
    activeDrag = {
      event.pointerId,
      startCandidates: filtered,
      startPoint: { x: event.clientX, y: event.clientY },
      startEdgeId: startPath?.dataset.edgeId,
      startVertexId
    };
    try {
      graphCanvas.setPointerCapture(event.pointerId);
    } catch {
      // Pointer capture is an enhancement; the gesture can still finish over the canvas.
    }
  };

  trackDrag := (event: PointerEvent) => {
    drag := activeDrag;
    if (drag?.pointerId is event.pointerId) {
      event.preventDefault();
      if endsNearStartVertex(event)
        setHovered(null);
        return;
      sameZone := resolveSameEdgeZone(event);
      if sameZone
        setHovered({ edge: sameZone.edge.id, sameZone.zone });
        return;
      resolution := resolveDrag(event);
      setHovered(resolution ? { edge: resolution.edge.id, zone: resolution.direction } : null);
      return;
    }
    path := (event.target as Element | null)?.closest?.(".edge-hit") as SVGPathElement | null;
    edge := path and selectedGraph().edges.find(({ id }) => id is path.dataset.edgeId);
    if (not path or not edge or not graphCanvas) {
      setHovered(null);
      return;
    }
    fraction := closestFraction(path, eventPoint(event, graphCanvas));
    setHovered({ edge: edge.id, zone: edgeZone(fraction) });
  };

  finishDrag := (event: PointerEvent) => {
    drag := activeDrag;
    if (not drag or drag.pointerId is not event.pointerId or not graphCanvas) return;
    sameVertex := endsNearStartVertex(event);
    sameZone := sameVertex ? null : resolveSameEdgeZone(event);
    resolution := resolveDrag(event);
    moved := Math.hypot(
      event.clientX - drag.startPoint.x,
      event.clientY - drag.startPoint.y
    ) >= ENDPOINT_DRAG_MINIMUM_PIXELS;
    activeDrag = null;
    try {
      graphCanvas.releasePointerCapture(event.pointerId);
    } catch {
      // The browser may already have released capture.
    }
    setHovered(null);
    if (sameVertex) {
      event.preventDefault();
      vertex := selectedGraph().vertices.find(({ id }) => id is drag.startVertexId);
      if (vertex) applyForcedAt(vertex);
      if drag.startVertexId
        suppressedVertexClick = { vertexId: drag.startVertexId, expires: performance.now() + 750 };
      return;
    }
    if (sameZone) {
      event.preventDefault();
      if (drag.startEdgeId) suppressedEdgeClick = { edgeId: drag.startEdgeId, expires: performance.now() + 750 };
      if (drag.startVertexId) suppressedVertexClick = { vertexId: drag.startVertexId, expires: performance.now() + 750 };
      setEdge(sameZone.edge.id, sameZone.zone is 2 ? null : sameZone.zone);
      return;
    }
    if (moved) {
      event.preventDefault();
      if (drag.startEdgeId) suppressedEdgeClick = { edgeId: drag.startEdgeId, expires: performance.now() + 750 };
      if (drag.startVertexId) suppressedVertexClick = { vertexId: drag.startVertexId, expires: performance.now() + 750 };
      if (resolution) setEdge(resolution.edge.id, resolution.direction);
      return;
    }
    event.preventDefault();
    if (drag.startEdgeId) {
      candidate := drag.startCandidates.find(({ edge, source }) => {
        return edge.id is drag.startEdgeId and source is "edge";
      });
      if candidate
        zone := edgeZone(candidate.fraction);
        setEdge(candidate.edge.id, zone is 2 ? null : zone);
        suppressedEdgeClick = { edgeId: candidate.edge.id, expires: performance.now() + 750 };
    } else if (drag.startVertexId) {
      vertex := selectedGraph().vertices.find(({ id }) => id is drag.startVertexId);
      if (vertex) applyForcedAt(vertex);
      suppressedVertexClick = { vertexId: drag.startVertexId, expires: performance.now() + 750 };
    }
  };

  cancelDrag := (event: PointerEvent) => {
    if (activeDrag?.pointerId is event.pointerId) {
      activeDrag = null;
      setHovered(null);
    }
  };

  reserveTouchStart := (event: TouchEvent) => {
    touch := event.touches?.[0];
    nearEndpoint := touch and graphCanvas and endpointCandidatesNear(eventPoint(
      { touch.{clientX,clientY} } as PointerEvent,
      graphCanvas
    ))# > 0;
    if (activeDrag !== null or nearEndpoint) event.preventDefault();
  };

  reserveActiveTouch := (event: TouchEvent) => {
    if (activeDrag !== null) event.preventDefault();
  };

  clickVertex := (vertex: Vertex) => {
    if (suppressedVertexClick?.vertexId is vertex.id and performance.now() <= suppressedVertexClick.expires) {
      suppressedVertexClick = null;
      return;
    }
    suppressedVertexClick = null;
    applyForcedAt(vertex);
  };

  stateSummary := => {
    current := progress();
    if (current.solved) return { tone: "success", title: "Solved", text: "Every edge is oriented and every vertex is satisfied." };
    if (current.impossible > 0) return {
      tone: "danger",
      title: "Contradiction",
      text: contradictionSummary(current.violated, current.incompleteImpossible)
    };
    if (current.edgeConflicts > 0) return {
      tone: "danger",
      title: "Forced conflict",
      text: "Two neighboring vertices require an unoriented edge in opposite directions."
    };
    if (current.forced > 0) return {
      tone: "hint",
      title: `${current.forced} forced ${current.forced is 1 ? "vertex" : "vertices"}`,
      text: "Dashed arrows show deductions. Click a cyan vertex to apply its forced edges."
    };
    return {
      tone: "neutral",
      title: "In progress",
      text: `${current.oriented} of ${selectedGraph().edges.length} edges oriented.`
    };
  };

  groups := ["Full graphs", "Paper gadgets"] as const;

  handleHistoryKeyDown := (event: KeyboardEvent) => {
    if (event.defaultPrevented or event.altKey or (not event.ctrlKey and not event.metaKey)) return;
    target := event.target;
    if (
      target instanceof HTMLInputElement or
      target instanceof HTMLTextAreaElement or
      (target instanceof HTMLElement and target.isContentEditable)
    ) return;
    key := event.key.toLowerCase();
    action := key is "z" ? (event.shiftKey ? redo : undo) : key is "y" ? redo : null;
    if (not action or (action is undo ? not canUndo() : not canRedo())) return;
    event.preventDefault();
    action();
  };

  window.addEventListener("keydown", handleHistoryKeyDown);
  onCleanup(=> window.removeEventListener("keydown", handleHistoryKeyDown));

  createEffect(=> {
    document.documentElement.dataset.theme = theme();
  });

  toggleTheme := => {
    next := theme() is "dark" ? "light" : "dark";
    setTheme(next);
    try {
      window.localStorage.setItem(THEME_STORAGE_KEY, next);
    } catch {
      // The toggle still works for this page when storage is unavailable.
    }
  };

  downloadSvg := => {
    return unless graphCanvas
    blob := new Blob([serializeGraphSvg(graphCanvas, theme())], {
      type: "image/svg+xml;charset=utf-8"
    });
    url := URL.createObjectURL(blob);
    link := document.createElement("a");
    link.href = url;
    link.download = `${selectedGraph().id}.svg`;
    link.hidden = true;
    document.body.append(link);
    link.click();
    link.remove();
    window.setTimeout(=> URL.revokeObjectURL(url), 0);
  };

  return (
    <div .app-shell>
      <header .masthead>
        <img .brand-mark src="./favicon.svg" alt="" aria-hidden="true">
        <div .brand-copy>
          <h1 aria-label="Graph Orientation Playground">
            <span .title-small-caps aria-hidden="true">
              <span><span .title-initial>G</span>RAPH</span>{" "}
              <span><span .title-initial>O</span>RIENTATION</span>{" "}
              <span><span .title-initial>P</span>LAYGROUND
        <div .masthead-actions>
          <button
            class="theme-toggle"
            type="button"
            aria-label="Dark mode"
            aria-pressed={theme() is "dark"}
            title={`Switch to ${theme() is "dark" ? "light" : "dark"} mode`}
            onClick=toggleTheme
          >
            <span .theme-toggle__icon aria-hidden="true">{theme() is "dark" ? "☾" : "☀"}
          <a .masthead-link.paper-link href="https://arxiv.org/abs/2603.03488" target="_blank" rel="noreferrer">
            <span .masthead-link__label>Paper
            <span .external-arrow aria-hidden="true">↗
          <a
            class="masthead-link github-link"
            href="https://github.com/edemaine/graph-orientation-visualizer"
            target="_blank"
            rel="noreferrer"
          >
            <svg .github-icon viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 6.32c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z">
            <span .masthead-link__label>GitHub
            <span .external-arrow aria-hidden="true">↗

      <main .workspace>
        <aside .control-panel aria-label="Visualizer controls">
          <section>
            <label .field-label for="example">Example
            <div .select-wrap>
              <select #example value={selectedId()} onChange={(event) => chooseExample(event.currentTarget.value)}>
                <For each=groups>{(group) => (
                  <optgroup label=group>
                    <For each={EXAMPLES.filter((example) => example.group is group)}>{(example) => (
                      <option value=example.id>{example.title}
                    )}
                )}
            <p .description>
              <For each={parseLabelMarkup(selectedGraph().description)}>{(part) => (
                part.italic ? <i>{part.text}</i> : part.text
              )}
              <Show when={selectedGraph().source}>{(source) => (
                <a .description-source href={source().url} target="_blank" rel="noreferrer">
                  {source().label} <span aria-hidden="true">↗
              )}

          <div .vertex-info>
            <section .vertex-types>
              <h3>Vertex types
              <dl .vertex-type-list aria-label="Vertex types in this example">
                <For each={vertexTypes()}>{({ symbol, rule }) => (
                  <div .vertex-type>
                    <dt .vertex-type-symbol><span>{symbol}</span></dt>
                    <dd>{rule}
                )}

            <section .legend aria-label="Vertex state legend">
              <div .legend-grid>
                <span><i .dot.dot--open />Open
                <span><i .dot.dot--forced />Forced
                <span><i .dot.dot--satisfied />Satisfied
                <span><i .dot.dot--impossible />Impossible

          <section class={`state-card state-card--${stateSummary().tone}`} aria-live="polite">
            <div .state-card__icon aria-hidden="true">
              {progress().solved ? "✓" : progress().impossible or progress().edgeConflicts ? "!" : progress().forced ? "↯" : "·"}
            <div>
              <strong>{stateSummary().title}
              <p>{stateSummary().text}
            <Show when={progress().forced > 0 and progress().impossible is 0 and progress().edgeConflicts is 0}>
              <button .state-card__apply type="button" onClick=applyAllForced>
                Apply all forced edges

          <section .how-to>
            <h3>How to play
            <ol>
              <li><span .step-number>1</span><span>Click near an endpoint, or swipe along an edge, to orient it.</span></li>
              <li><span .step-number>2</span><span>Click its middle third to remove the arrow.</span></li>
              <li><span .step-number>3</span><span>Click a cyan vertex to apply its forced moves.</span></li>

          <button .reset-button type="button" onClick={=> commitDirections(emptyDirections(selectedGraph()))}>
            <span aria-hidden="true">↺</span> Reset orientations

        <section .canvas-panel aria-label={`${selectedGraph().title} graph`}>
          <div class={`graph-frame${progress().solved ? " graph-frame--solved" : ""}`}>
            <svg
              ref=graphCanvas!
              class="graph-canvas"
              viewBox={(selectedGraph().viewBox ?? [0, 0, 800, 560]).join(" ")}
              role="img"
              aria-label={`Interactive graph: ${selectedGraph().title}`}
              onPointerDown={(event) => beginDrag(event)}
              onPointerMove={(event) => trackDrag(event)}
              onPointerUp={(event) => finishDrag(event)}
              onPointerCancel={(event) => cancelDrag(event)}
              onPointerLeave={=> {
                if (not activeDrag) setHovered(null);
              }}
              on:touchstart=reserveTouchStart
              on:touchmove=reserveActiveTouch
            >
              <defs>
                <!-- Arrowhead geometry from Cocreate's client/DrawApp.coffee:
                    https://github.com/edemaine/cocreate/blob/main/client/DrawApp.coffee -->
                <marker #arrow viewBox="0 0 10 10" refX="9.5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse" overflow="visible">
                  <path d="M 0 -1 L 10 3.854 A 1.252 1.252 0 0 1 10 6.146 L 0 11 z">
                <marker #preview-arrow viewBox="0 0 10 10" refX="9.5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse" overflow="visible">
                  <path d="M 0 -1 L 10 3.854 A 1.252 1.252 0 0 1 10 6.146 L 0 11 z">
                <marker #ghost-arrow viewBox="0 0 10 10" refX="9.5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse" overflow="visible">
                  <path d="M 0 -1 L 10 3.854 A 1.252 1.252 0 0 1 10 6.146 L 0 11 z">
                <filter #success-glow x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="5" result="blur">
                  <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>

              <g .edge-layer>
                <For each={selectedGraph().edges}>{(edge) => {
                  geometry := => { return edgeGeometry(selectedGraph(), edge); };
                  direction := => { return directions()[edge.id] ?? null; };
                  forced := => { return forcedEdges()[edge.id] ?? { direction: null, conflict: false }; };
                  hover := => { return hovered()?.edge is edge.id ? hovered()?.zone : undefined; };
                  return (
                    <g class={`edge-group${forced().conflict ? " edge-group--conflict" : ""}${hover() is not undefined ? " edge-group--previewing" : ""}`}>
                      <g .edge-visual>
                        <path .edge-base d={geometry().forward}>
                        <Show when={direction() !== null}>
                          <path
                            class="edge-oriented"
                            d={direction() is 1 ? geometry().forward : geometry().reverse}
                            marker-end="url(#arrow)"
                          >
                        <Show when={direction() === null and forced().direction !== null}>
                          <path
                            class="edge-forced"
                            d={forced().direction is 1 ? geometry().forward : geometry().reverse}
                            marker-end="url(#ghost-arrow)"
                          >
                        <Show when={forced().conflict}>
                          <path .edge-conflict d={geometry().forward}>
                      <Show when={hover() is not undefined}>
                        <path
                          class={`edge-preview edge-preview--${hover() is 2 ? "undirected" : "directed"}`}
                          d={hover() is 0 ? geometry().reverse : geometry().forward}
                          marker-end={hover() is 2 ? undefined : "url(#preview-arrow)"}
                        >
                      <path
                        class="edge-hit"
                        data-edge-id=edge.id
                        d={geometry().forward}
                        tabindex="0"
                        role="button"
                        aria-label={`${edge.id}: ${direction() === null ? "unoriented" : directionLabel(edge, direction() as 0 | 1)}. Swipe or drag along the edge to orient it; Enter cycles direction; Delete clears.`}
                        onClick={(event) => clickEdge(event, edge)}
                        on:touchstart={(event) => event.preventDefault()}
                        on:touchmove={(event) => event.preventDefault()}
                        onKeyDown={(event) => {
                          if (event.key is "Enter" or event.key is " ") {
                            event.preventDefault();
                            cycleEdge(edge);
                          } else if (event.key is "Delete" or event.key is "Backspace") {
                            event.preventDefault();
                            setEdge(edge.id, null);
                          }
                        }}
                      >
                  );
                }}

              <g .vertex-layer>
                <For each={selectedGraph().vertices}>{(vertex) => {
                  analysis := => { return analyses()[vertex.id] ?? {
                    state: "open" as const,
                    compatible: [],
                    forced: new Map<string, 0 | 1>(),
                    assignedPorts: 0,
                    totalPorts: 0
                  }; };
                  clickable := => { return analysis().state is "forced"; };
                  vertexName := => {
                    name := vertex.annotation?.text ?? vertex.label;
                    return name is undefined ? undefined : plainLabel(name);
                  };
                  interiorLabel := => { return vertex.label ?? vertex.constraint.shortLabel; };
                  annotation := => {
                    return null unless vertex.annotation
                    corner := vertex.annotation.corner ?? "top-right";
                    right := corner.endsWith("right");
                    bottom := corner.startsWith("bottom");
                    return {
                      ...vertex.annotation,
                      x: (right ? 1 : -1) * (NODE_RADIUS + 4),
                      y: (bottom ? 1 : -1) * (NODE_RADIUS + 4),
                      anchor: (right ? "start" : "end") as "start" | "end"
                    };
                  };
                  portLabels := => {
                    groups := vertex.constraint.portGroups;
                    return [] unless groups
                    return incidencesAt(selectedGraph(), vertex.id).map((incidence) => {
                      geometry := edgeGeometry(selectedGraph(), incidence.edge);
                      endpoint := incidence.endIndex is 0 ? geometry.start : geometry.end;
                      direction := unit({ x: endpoint.x - vertex.x, y: endpoint.y - vertex.y });
                      radius := NODE_RADIUS - 8;
                      group := groups[incidence.port];
                      return {
                        group,
                        label: group is 0 ? "+" : "−",
                        x: direction.x * radius,
                        y: direction.y * radius
                      };
                    });
                  };
                  return (
                    <g
                      class={`vertex vertex--${analysis().state}${clickable() ? " vertex--clickable" : ""}`}
                      data-vertex-id=vertex.id
                      transform={`translate(${vertex.x} ${vertex.y})`}
                      role={clickable() ? "button" : undefined}
                      tabindex={clickable() ? 0 : -1}
                      aria-label={`${vertexName() ? `${vertexName()}, ` : ""}${vertex.constraint.name} vertex: ${analysis().state}. ${analysis().compatible.length} compatible local completions.`}
                      onClick={=> clickVertex(vertex)}
                      on:touchstart={(event) => event.preventDefault()}
                      on:touchmove={(event) => event.preventDefault()}
                      onKeyDown={(event) => {
                        if (clickable() and (event.key is "Enter" or event.key is " ")) {
                          event.preventDefault();
                          applyForcedAt(vertex);
                        }
                      }}
                    >
                      <title>{vertexName() ? `${vertexName()}: ` : ""}{vertex.constraint.name}, {analysis().state}
                      <circle .vertex-halo r="36">
                      <g .vertex-shape>
                        <circle .vertex-body r=NODE_RADIUS>
                      <text
                        class={`vertex-label${[...interiorLabel()].length is 1 ? " vertex-label--single-character" : ""}`}
                        text-anchor="middle"
                        dominant-baseline="central"
                      >{interiorLabel()}
                      <Show when={annotation()}>{(visibleAnnotation) => (
                        <text
                          class="vertex-annotation"
                          x={visibleAnnotation().x}
                          y={visibleAnnotation().y}
                          text-anchor={visibleAnnotation().anchor}
                          dominant-baseline="central"
                          aria-hidden="true"
                        >
                          <For each={parseLabelMarkup(visibleAnnotation().text)}>{(part) => (
                            <tspan font-style={part.italic ? "italic" : "normal"}>{part.text}
                          )}
                      )}
                      <For each={portLabels()}>{(label) => (
                        <text
                          class={`port-pair-label port-pair-label--${label.group}`}
                          x=label.x
                          y=label.y
                          text-anchor="middle"
                          dominant-baseline="central"
                          aria-hidden="true"
                        >{label.label}
                      )}
                      <Show when={analysis().state is "satisfied"}>
                        <g .vertex-badge><circle cx="23" cy="-23" r="10" /><text x="23" y="-22" text-anchor="middle" dominant-baseline="central">✓</text></g>
                      <Show when={analysis().state is "impossible"}>
                        <g .vertex-badge><circle cx="23" cy="-23" r="10" /><text x="23" y="-22" text-anchor="middle" dominant-baseline="central">!</text></g>
                  );
                }}
            <Show when={progress().solved}>
              <div .victory-toast role="status"><span>✓</span> Orientation complete
          <div .canvas-footer>
            <div .canvas-history>
              <span .counter><strong>{progress().oriented}</strong> / {selectedGraph().edges#} edges
              <div .history-controls role="group" aria-label="Orientation history">
                <button
                  class="history-button"
                  type="button"
                  disabled={not canUndo()}
                  aria-label="Undo orientation change"
                  title={`Undo (${historyModifier} + Z)`}
                  onClick=undo
                >
                  <span aria-hidden="true">↶</span><span .history-button__label>Undo
                <button
                  class="history-button"
                  type="button"
                  disabled={not canRedo()}
                  aria-label="Redo orientation change"
                  title={usesCommandKey
                    ? "Redo (Command + Shift + Z)"
                    : "Redo (Ctrl + Y)"}
                  onClick=redo
                >
                  <span aria-hidden="true">↷</span><span .history-button__label>Redo
            <p .keyboard-note>
              Keyboard: <kbd>Enter</kbd> cycles, <kbd>Delete</kbd> clears, {" "}
              <Show
                when=usesCommandKey
                fallback={<span><kbd>Ctrl</kbd>+<kbd>Z</kbd> undo, <kbd>Ctrl</kbd>+<kbd>Y</kbd> redo.</span>}
              >
                <span><kbd>Command</kbd>+<kbd>Z</kbd> undo, <kbd>Command</kbd>+<kbd>Shift</kbd>+<kbd>Z</kbd> redo.
            <button .download-button type="button" onClick=downloadSvg>
              <span aria-hidden="true">↓</span> Download SVG
  );
